# Deployed VoteChain contract address on the Sepolia/local network
VITE_CONTRACT_ADDRESS=YOUR_DEPLOYED_CONTRACT_ADDRESS

# Pinata IPFS credentials (optional, for direct image uploading in Admin Dashboard)
# Option A: Use JWT token (Recommended by Pinata)
VITE_PINATA_JWT=YOUR_PINATA_JWT_TOKEN

# Option B: Use API Key & Secret (Fallback)
VITE_PINATA_API_KEY=YOUR_PINATA_API_KEY
VITE_PINATA_API_SECRET=YOUR_PINATA_API_SECRET
